    <type name="Magento\Quote\Model\Cart\Totals\ItemConverter">
        <plugin name="amerimark_fixedline_totals_item_fee"
                type="Amerimark\FixedLine\Plugin\Quote\Cart\TotalsItemConverterPlugin"/>
    </type>
    <type name="Magento\Sales\Api\OrderRepositoryInterface">
        <plugin name="amerimark_fixedline_order_item_fee"
                type="Amerimark\FixedLine\Plugin\Sales\OrderItemExtensionPlugin"/>
    </type>
    <type name="Magento\Sales\Api\OrderItemRepositoryInterface">
        <plugin name="amerimark_fixedline_order_item_repo_fee"
                type="Amerimark\FixedLine\Plugin\Sales\OrderItemExtensionPlugin"/>
    </type>
    <type name="Magento\QuoteGraphQl\Model\Resolver\CartItemPrices">
        <plugin name="amerimark_fixedline_cart_item_prices"
                type="Amerimark\FixedLine\Plugin\QuoteGraphQl\CartItemPricesPlugin"/>
    </type>
    <type name="Magento\SalesGraphQl\Model\OrderItemPrices\PricesProvider">
        <plugin name="amerimark_fixedline_order_item_prices"
                type="Amerimark\FixedLine\Plugin\SalesGraphQl\PricesProviderPlugin"/>
    </type>
</config>
