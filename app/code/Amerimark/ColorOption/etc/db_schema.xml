<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="amerimark_color_group" resource="default" engine="innodb" comment="Color Option Group">
        <column xsi:type="int" name="group_id" unsigned="true" nullable="false" identity="true" comment="Group ID"/>
        <column xsi:type="varchar" name="name" nullable="false" length="255" comment="Group Name"/>
        <column xsi:type="smallint" name="is_active" unsigned="true" nullable="false" default="1" comment="Is Active"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="false" comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="true" comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="group_id"/>
        </constraint>
    </table>
    <table name="amerimark_color_group_item" resource="default" engine="innodb" comment="Color Option Group Color">
        <column xsi:type="int" name="item_id" unsigned="true" nullable="false" identity="true" comment="Color ID"/>
        <column xsi:type="int" name="group_id" unsigned="true" nullable="false" comment="Group ID"/>
        <column xsi:type="varchar" name="name" nullable="false" length="255" comment="Color name (shown to shoppers)"/>
        <column xsi:type="varchar" name="hex" nullable="false" length="7" comment="Display color #RRGGBB"/>
        <column xsi:type="varchar" name="pms" nullable="true" length="64" comment="PMS (Pantone) reference, staff only"/>
        <column xsi:type="text" name="comment" nullable="true" comment="Staff-only comment"/>
        <column xsi:type="int" name="sort_order" unsigned="true" nullable="false" default="0" comment="Sort Order"/>
        <column xsi:type="smallint" name="is_active" unsigned="true" nullable="false" default="1" comment="Is Active"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="item_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="AMERIMARK_COLOR_GROUP_ITEM_GROUP_ID_AMERIMARK_COLOR_GROUP_GROUP_ID"
                    table="amerimark_color_group_item" column="group_id"
                    referenceTable="amerimark_color_group" referenceColumn="group_id" onDelete="CASCADE"/>
        <index referenceId="AMERIMARK_COLOR_GROUP_ITEM_GROUP_ID_SORT_ORDER" indexType="btree">
            <column name="group_id"/>
            <column name="sort_order"/>
        </index>
    </table>
    <table name="amerimark_color_option_value" resource="default" engine="innodb" comment="Which group color a color option value is">
        <column xsi:type="int" name="option_type_id" unsigned="true" nullable="false" comment="Option Type Value ID"/>
        <column xsi:type="int" name="color_id" unsigned="true" nullable="false" comment="Color ID"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="option_type_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="AMERIMARK_COLOR_OPTION_VALUE_OPTION_TYPE_ID_CAT_PRD_OPT_TYPE_VAL_OPTION_TYPE_ID"
                    table="amerimark_color_option_value" column="option_type_id"
                    referenceTable="catalog_product_option_type_value" referenceColumn="option_type_id" onDelete="CASCADE"/>
        <constraint xsi:type="foreign" referenceId="AMERIMARK_COLOR_OPTION_VALUE_COLOR_ID_AMERIMARK_COLOR_GROUP_ITEM_ITEM_ID"
                    table="amerimark_color_option_value" column="color_id"
                    referenceTable="amerimark_color_group_item" referenceColumn="item_id" onDelete="NO ACTION"/>
        <index referenceId="AMERIMARK_COLOR_OPTION_VALUE_COLOR_ID" indexType="btree">
            <column name="color_id"/>
        </index>
    </table>
</schema>
