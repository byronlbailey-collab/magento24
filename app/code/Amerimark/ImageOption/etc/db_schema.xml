<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="amerimark_image_group" resource="default" engine="innodb" comment="Image Option Group">
        <column xsi:type="int" name="group_id" unsigned="true" nullable="false" identity="true" comment="Group ID"/>
        <column xsi:type="varchar" name="name" nullable="false" length="255" comment="Group Name"/>
        <column xsi:type="smallint" name="is_active" unsigned="true" nullable="false" default="1" comment="Is Active"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="false" comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="true" comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="group_id"/>
        </constraint>
    </table>
    <table name="amerimark_image_group_item" resource="default" engine="innodb" comment="Image Option Group Item">
        <column xsi:type="int" name="item_id" unsigned="true" nullable="false" identity="true" comment="Item ID"/>
        <column xsi:type="int" name="group_id" unsigned="true" nullable="false" comment="Group ID"/>
        <column xsi:type="varchar" name="label" nullable="false" length="255" comment="Label"/>
        <column xsi:type="varchar" name="sku" nullable="true" length="64" comment="SKU"/>
        <column xsi:type="varchar" name="image" nullable="false" length="255" comment="Image file name"/>
        <column xsi:type="int" name="sort_order" unsigned="true" nullable="false" default="0" comment="Sort Order"/>
        <column xsi:type="smallint" name="is_active" unsigned="true" nullable="false" default="1" comment="Is Active"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="item_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="AMERIMARK_IMAGE_GROUP_ITEM_GROUP_ID_AMERIMARK_IMAGE_GROUP_GROUP_ID"
                    table="amerimark_image_group_item" column="group_id"
                    referenceTable="amerimark_image_group" referenceColumn="group_id" onDelete="CASCADE"/>
        <index referenceId="AMERIMARK_IMAGE_GROUP_ITEM_GROUP_ID_SORT_ORDER" indexType="btree">
            <column name="group_id"/>
            <column name="sort_order"/>
        </index>
    </table>
    <table name="catalog_product_option">
        <column xsi:type="int" name="image_group_id" unsigned="true" nullable="true" comment="Image Group ID (Amerimark_ImageOption)"/>
        <column xsi:type="smallint" name="image_allow_upload" unsigned="true" nullable="false" default="0" comment="Allow customer logo upload (Amerimark_ImageOption)"/>
        <constraint xsi:type="foreign" referenceId="CATALOG_PRODUCT_OPTION_IMAGE_GROUP_ID_AMERIMARK_IMAGE_GROUP_GROUP_ID"
                    table="catalog_product_option" column="image_group_id"
                    referenceTable="amerimark_image_group" referenceColumn="group_id" onDelete="NO ACTION"/>
    </table>
</schema>
